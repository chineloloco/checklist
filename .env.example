# PostgreSQL/Neon: use the pooled connection string in runtime and a direct URL for migrations when available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# NextAuth session signing. Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters

# Optional generic OIDC provider. Leave empty when using the system's own users and passwords.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# First-party users and passwords for web and mobile. Keep enabled when this is the chosen authentication mode.
AUTH_ALLOW_CREDENTIALS=true
# Access tokens use this secret; when empty, NEXTAUTH_SECRET is used. Use a separate 32+ character value in production.
MOBILE_AUTH_SECRET=
SEED_ADMIN_EMAIL=admin@checklist.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123!
SEED_INSPECTOR_EMAIL=responsavel@checklist.local
SEED_INSPECTOR_PASSWORD=ChangeMe-Responsavel-123!

# Initial organization decisions.
DEFAULT_TIMEZONE=America/Fortaleza
DEFAULT_WEEK_STARTS_ON=MONDAY

# Optional object storage for future photo/drawn-signature binaries.
# The current slice stores signature metadata only and does not require files.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
